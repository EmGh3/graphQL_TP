generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String
  role  Role
  cvs   Cv[]
}

model Skill {
  id           Int     @id @default(autoincrement())
  designation  String
  cvs         Cv[]    @relation("SkillToCv") //  PAS de "references"
}

model Cv {
  id       Int     @id @default(autoincrement())
  name     String
  age      Int
  job      String
  user     User    @relation(fields: [userId], references: [id])
  userId   Int
  skills  Skill[] @relation("SkillToCv")
}

enum Role {
  ADMIN
  USER
}
